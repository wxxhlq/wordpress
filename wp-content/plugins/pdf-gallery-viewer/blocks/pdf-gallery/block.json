{
  "apiVersion": 2,
  "name": "pdf-gallery/pdf-multi-block",
  "title": "PDF Gallery (Multiplo)",
  "category": "media",
  "icon": "media-document",
  "description": "Inserisci una galleria PDF con più documenti.",
  "supports": {
    "html": false
  },
  "attributes": {
    "galleryId": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": []
    },
    "layout": {
      "type": "string",
      "default": "grid"
    },
    "ui": {
      "type": "boolean",
      "default": true
    },
    "accentColor": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "pdf-gallery-editor"
}
